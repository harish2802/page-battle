# Copy to .env (never commit .env) -- the server reads real environment variables,
# so export these in your shell, or use `node --env-file=.env server/index.js`.

PORT=3000
HOST=0.0.0.0

# SQLite file. On hosts with ephemeral disks, point this at a persistent volume.
DATABASE_PATH=data/page-battle.sqlite

# Disconnect/reconnect window in ms (spec: 2 minutes = 120000)
RECONNECT_MS=120000

# Room housekeeping
ROOM_TTL_HOURS=24
FINISHED_ROOM_TTL_MINUTES=30

# Animation pacing (ms). Only change if you change the client animations.
PREGAME_MS=6000
ROLL_ANIM_MS=2600
ATTACK_ANIM_MS=3800
ELIMINATION_ANIM_MS=1800
BOT_THINK_MS=1200
BOT_AIM_MS=2800

# Basic abuse protection: max create/join/rejoin requests per IP per minute
RATE_LIMIT_PER_MIN=40
TRUST_PROXY=0

# Max WebSocket messages per second per connection
WS_MESSAGES_PER_SEC=30
